    "project_set_mission_status": { "action": "set_mission_status", "scope": "project", "riskClass": "durable_orchestrator_write", "decision": "approval_required", "reason": "Mission status mutation remains approval-gated in v1" },
    "project_archive": { "action": "archive", "scope": "project", "riskClass": "durable_orchestrator_write", "decision": "approval_required", "reason": "Project archive remains approval-gated in v1" },

    "gmail_send": { "action": "send", "scope": "messaging", "riskClass": "normal_message", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },
    "gmail_reply": { "action": "reply", "scope": "messaging", "riskClass": "normal_message", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },
    "whatsapp_send": { "action": "send", "scope": "messaging", "riskClass": "normal_message", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },

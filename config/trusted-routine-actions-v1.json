{
  "policyVersion": "trusted-routine-actions-v1",
  "description": "Standing routine-action authority for Trusted Developer / local agent work. Final-clause precedence: destructive, system, security, production, merge, and credential mutations remain approval_required or deny even when an earlier automatic clause mentioned a related category.",
  "precedence": {
    "rule": "final_clause_overrides",
    "note": "Keep destructive/system/security/production/merge/credential actions behind explicit approval overrides any earlier automatic listing of the same category."
  },
  "capabilities": {
    "personal_memory_remember": { "action": "remember", "scope": "personal_memory", "riskClass": "routine_durable_write", "decision": "auto_allow", "reason": "Standing Personal Memory write authority" },
    "personal_memory_update": { "action": "update", "scope": "personal_memory", "riskClass": "routine_durable_write", "decision": "auto_allow", "reason": "Standing Personal Memory update authority" },
    "personal_memory_forget": { "action": "forget", "scope": "personal_memory", "riskClass": "routine_durable_write", "decision": "auto_allow", "reason": "Standing Personal Memory forget authority" },
    "personal_memory_get": { "action": "get", "scope": "personal_memory", "riskClass": "read", "decision": "auto_allow", "reason": "Personal Memory read" },
    "personal_memory_search": { "action": "search", "scope": "personal_memory", "riskClass": "read", "decision": "auto_allow", "reason": "Personal Memory search" },
    "personal_memory_recent": { "action": "recent", "scope": "personal_memory", "riskClass": "read", "decision": "auto_allow", "reason": "Personal Memory recent read" },

    "read": { "action": "read", "scope": "repository", "riskClass": "safe_read", "decision": "auto_allow", "reason": "Safe repository read" },
    "ls": { "action": "list", "scope": "repository", "riskClass": "safe_read", "decision": "auto_allow", "reason": "Safe directory list" },
    "find": { "action": "find", "scope": "repository", "riskClass": "safe_read", "decision": "auto_allow", "reason": "Safe find" },
    "grep": { "action": "grep", "scope": "repository", "riskClass": "safe_read", "decision": "auto_allow", "reason": "Safe grep" },
    "write": { "action": "write", "scope": "repository", "riskClass": "safe_write", "decision": "auto_allow", "reason": "Task-scoped safe write" },
    "edit": { "action": "edit", "scope": "repository", "riskClass": "safe_write", "decision": "auto_allow", "reason": "Task-scoped safe edit" },
    "test": { "action": "test", "scope": "repository", "riskClass": "safe_verify", "decision": "auto_allow", "reason": "Pinned test job" },
    "build": { "action": "build", "scope": "repository", "riskClass": "safe_verify", "decision": "auto_allow", "reason": "Pinned build/typecheck/lint job" },
    "trusted-development": { "action": "trusted_job", "scope": "repository", "riskClass": "safe_dev_job", "decision": "auto_allow", "reason": "Bounded trusted development job (status/diff/commit/push/PR create/update when job allows)" },

    "bridge-maintenance": { "action": "bridge_maintenance", "scope": "local_maintenance", "riskClass": "allowlisted_restart", "decision": "auto_allow", "reason": "Pinned bridge_restart / bridge_restart_status only" },

    "project_list": { "action": "list", "scope": "project", "riskClass": "read", "decision": "auto_allow", "reason": "Project hierarchy read" },
    "project_get": { "action": "get", "scope": "project", "riskClass": "read", "decision": "auto_allow", "reason": "Project get" },
    "project_summary": { "action": "summary", "scope": "project", "riskClass": "read", "decision": "auto_allow", "reason": "Project summary" },
    "project_next_action": { "action": "next_action", "scope": "project", "riskClass": "suggestion_only", "decision": "auto_allow", "reason": "Next Action is suggestion-only; execution not_dispatched" },
    "project_create": { "action": "create", "scope": "project", "riskClass": "durable_orchestrator_write", "decision": "approval_required", "reason": "Project create remains approval-gated in v1" },
    "project_create_goal": { "action": "create_goal", "scope": "project", "riskClass": "durable_orchestrator_write", "decision": "approval_required", "reason": "Goal create remains approval-gated in v1" },

    "messaging_bulk_broadcast": { "action": "bulk_broadcast", "scope": "messaging", "riskClass": "bulk_message", "decision": "approval_required", "reason": "Final-clause: bulk/broadcast messaging requires approval", "active": false },

    "calendar_event_create": { "action": "create", "scope": "calendar", "riskClass": "routine_schedule", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },
    "calendar_event_update": { "action": "update", "scope": "calendar", "riskClass": "routine_schedule", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },
    "reminder_create": { "action": "create", "scope": "reminders", "riskClass": "routine_schedule", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },
    "reminder_update": { "action": "update", "scope": "reminders", "riskClass": "routine_schedule", "decision": "auto_allow", "reason": "Policy category only; inactive until connector exists", "active": false },

    "git_push_protected": { "action": "push_protected", "scope": "repository", "riskClass": "protected_branch", "decision": "approval_required", "reason": "Final-clause: protected/main production-equivalent push requires approval" },
    "pr_merge": { "action": "merge", "scope": "repository", "riskClass": "production_merge", "decision": "approval_required", "reason": "Final-clause: PR merge requires approval; no auto-merge" },
    "production_deploy": { "action": "deploy", "scope": "production", "riskClass": "production_mutation", "decision": "approval_required", "reason": "Final-clause: production deploys require approval" },
    "destructive_operation": { "action": "destructive", "scope": "system", "riskClass": "destructive", "decision": "approval_required", "reason": "Final-clause: destructive operations require approval" },
    "system_software_install": { "action": "install", "scope": "system", "riskClass": "system_mutation", "decision": "approval_required", "reason": "Final-clause overrides earlier automatic listing: system software install requires approval" },
    "system_software_uninstall": { "action": "uninstall", "scope": "system", "riskClass": "system_mutation", "decision": "approval_required", "reason": "Final-clause overrides earlier automatic listing: system software uninstall requires approval" },
    "sudo": { "action": "sudo", "scope": "system", "riskClass": "privileged", "decision": "deny", "reason": "Final-clause: sudo and privileged system mutations are denied without separate hardened authority" },
    "credential_mutation": { "action": "mutate_credentials", "scope": "security", "riskClass": "credential", "decision": "approval_required", "reason": "Final-clause: password/MFA/API-key/credential mutations require approval" },
    "financial_transaction": { "action": "transact", "scope": "finance", "riskClass": "financial", "decision": "approval_required", "reason": "Final-clause: financial transactions require approval" },
    "delete_unique_work": { "action": "delete_unique", "scope": "repository", "riskClass": "destructive_unique", "decision": "approval_required", "reason": "Final-clause: deletion of unique/unmerged work requires approval" },
    "destructive_git_unique": { "action": "destructive_git", "scope": "repository", "riskClass": "destructive_unique", "decision": "approval_required", "reason": "Final-clause: destructive Git involving unique/unmerged work requires approval" },
    "destructive_disk": { "action": "destructive_disk", "scope": "system", "riskClass": "destructive", "decision": "deny", "reason": "Final-clause: destructive disk/filesystem operations are denied" }
  }
}

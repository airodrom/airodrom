    "commandTimeoutMs": 60000
  },
  "acceptance": {
    "humanTurnsAfterAuthorization": 0,
    "manualStatusChecks": 0,
    "manualNextActions": 0,
    "hostTasks": 2,
    "hostCompletionEvents": 2,
    "realReasoningTurns": 2,
    "automaticNextTaskDispatches": 1,

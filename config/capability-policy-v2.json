{
  "policyVersion": "capability-expansion-v2",
  "basePolicyVersion": "trusted-routine-actions-v1",
  "description": "Typed Mac, developer-tool and personal-assistant capabilities. Every capability has an explicit risk class, standing decision and task scopes. Dynamic assessment may only escalate a decision. The trusted-routine-actions-v1 category named by v1Category is combined and the most restrictive decision wins, so a final restrictive clause always overrides an earlier broad authorization.",
  "precedence": { "rule": "most_restrictive_wins", "order": ["deny", "approval_required", "auto_allow"] },
  "riskClasses": ["READ_ONLY", "ROUTINE_WRITE", "EXTERNAL_WRITE", "DESTRUCTIVE", "PRIVILEGED", "SECURITY", "FINANCIAL"],
  "neverAutomaticClasses": ["DESTRUCTIVE", "PRIVILEGED", "SECURITY", "FINANCIAL"],
  "taskScopes": ["repo", "developer_environment", "personal", "mac_local", "communications", "calendar", "system_readonly"],
  "defaultTaskScopes": ["repo", "system_readonly"],
  "bulkRecipientThreshold": 5,
  "humanGates": {
    "claude_oauth_login": "Sign in to the Claude account in the browser flow that Claude Code opens.",
    "google_oauth_login": "Authorize the Google account in the Google consent screen.",
    "macos_accessibility": "Grant Accessibility access in System Settings > Privacy & Security > Accessibility.",
    "macos_screen_recording": "Grant Screen Recording access in System Settings > Privacy & Security > Screen & System Audio Recording.",
    "macos_automation": "Allow the Automation prompt for the target application in System Settings > Privacy & Security > Automation.",
    "touch_id_webauthn": "Complete Touch ID or security-key verification on the device.",
    "password_mfa_entry": "Enter the password or MFA code yourself; Pi never handles it.",
    "protected_operation_approval": "Review and approve the exact one-shot request in Control Center."
  },
  "alwaysDeny": {
    "policy_disable": "Disabling core safety policy is never available to a model",
    "approval_bypass": "Bypassing the approval mechanism is never available to a model",
    "credential_read_raw": "Raw stored credentials are never returned; use status capabilities",
    "auth_token_export": "Private authentication tokens are never exported",
    "assistant_text_tool_execution": "Assistant-text pseudo tool calls are never executed",
    "audit_record_mutation": "Pi audit records cannot be modified or deleted by a model"
  },
  "legacyTools": {
    "read": "READ_ONLY", "ls": "READ_ONLY", "find": "READ_ONLY", "grep": "READ_ONLY",
    "write": "ROUTINE_WRITE", "edit": "ROUTINE_WRITE", "run_job": "ROUTINE_WRITE",
    "mission_checkpoint": "ROUTINE_WRITE", "memory_search": "READ_ONLY", "web_fetch": "READ_ONLY",
    "chatgpt_notify": "EXTERNAL_WRITE",
    "personal_memory_get": "READ_ONLY", "personal_memory_search": "READ_ONLY", "personal_memory_recent": "READ_ONLY",
    "personal_memory_remember": "ROUTINE_WRITE", "personal_memory_update": "ROUTINE_WRITE", "personal_memory_forget": "ROUTINE_WRITE",
    "project_list": "READ_ONLY", "project_get": "READ_ONLY", "project_summary": "READ_ONLY", "project_next_action": "READ_ONLY",
    "project_create": "ROUTINE_WRITE", "project_create_goal": "ROUTINE_WRITE", "project_create_mission": "ROUTINE_WRITE",
    "project_set_mission_status": "ROUTINE_WRITE", "project_archive": "ROUTINE_WRITE",
    "capability": "READ_ONLY"
  },
